VUE_APP_API_BASE_URL=http://127.0.0.1:8080
# Base of the password-reset links the backend logs (AuthService.ForgotPassword).
FRONTEND_BASE_URL=http://localhost:4000
# Extends the backend's default CORS allow-list (localhost/127.0.0.1:4000) with
# this machine's own LAN IP, so the dev frontend is reachable from another
# device on the same network (a phone, say) at http://192.168.1.7:4000. Update
# the IP here (and VUE_APP_API_BASE_URL on the frontend service in
# docker-compose.yaml) if this machine's LAN address ever changes.
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://192.168.1.7:4000
# Optional: set BREVO_API_KEY (+ BREVO_SENDER_EMAIL, a sender verified in the
# Brevo account) to send real password-reset/invite emails via Brevo's
# transactional email API instead of only logging the link. Left unset here
# on purpose — local dev keeps the log-only behavior.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Calciotto
