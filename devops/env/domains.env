# The production domains, in one place.
#
# agoran.app is the app's domain. While LEGACY_FRONTEND_REDIRECT is true, the
# legacy frontend only redirects to it and every derived setting (CORS, the
# API map, the CSP, reset links, the /api/auth proxy) names agoran.app alone.
# false brings back both frontends side by side, each with its own API host.
# The legacy API host keeps answering either way: it is Koyeb's own name for
# the same service. Each value here is only a default: a GitHub repository variable of
# the same name overrides it at deploy time (.github/workflows/deploy.yml),
# and the variables the apps actually read (CORS_ALLOWED_ORIGINS,
# FRONTEND_BASE_URL, VUE_APP_API_BASE_URL, VUE_APP_API_BASE_URL_BY_HOST,
# AUTH_PROXY_TARGET) are derived from them unless set themselves.
#
# Bare origins: scheme://host, no path, no trailing slash.
LEGACY_FRONTEND_ORIGIN=https://calcio-otto.vercel.app
LEGACY_API_ORIGIN=https://calciotto.koyeb.app
NEW_FRONTEND_ORIGIN=https://club.agoran.app
NEW_API_ORIGIN=https://api.agoran.app

# true: calcio-otto.vercel.app answers every request with a temporary (307)
# redirect to the same path and query on club.agoran.app. false is the way
# back, with no code change (set the GitHub variable, then redeploy).
# Except /sw.js: that file stays served on the legacy host so the worker
# installed there can update and retire itself (unsubscribe from push,
# unregister). The retirement is keyed on the legacy host in public/sw.js,
# not on this flag, so after a switch back to false push notifications do
# not work on calcio-otto.vercel.app (club.agoran.app is unaffected).
LEGACY_FRONTEND_REDIRECT=true
